# ====================================================
# 상상우리 LiteLLM Governance PoC — 환경변수 예시
# 실제 사용 시 이 파일을 .env로 복사하고 값을 채운다
# .env 는 절대 git에 커밋하지 않는다
# ====================================================

# LiteLLM 마스터키 — 관리자 서버에서만 사용
LITELLM_MASTER_KEY=sk-master-changeme-xxxxxxxxxxxx

# DB — SQLite (PoC 기본), 운영 시 PostgreSQL URL로 교체
DATABASE_URL=sqlite:///./litellm_poc.db

# Redis — 선택사항. RPM/TPM 제한에 필요. 없으면 rate limit 미작동
# REDIS_URL=redis://localhost:6379

# LiteLLM Proxy 주소 (스크립트에서 사용)
LITELLM_BASE_URL=http://localhost:4000

# Provider API Keys (보유한 것만 설정, 없으면 fake provider로 테스트)
OPENROUTER_API_KEY=sk-or-changeme
ANTHROPIC_API_KEY=sk-ant-changeme
OPENAI_API_KEY=sk-changeme

# Phase 2.3 — 실제 Provider 검증용 (openrouter.ai / console.groq.com 에서 무료 발급)
# GROQ_API_KEY=gsk_changeme
# 위 OPENROUTER_API_KEY 값을 실제 키로 교체하면 Phase 2.3 즉시 실행 가능

# PoC 테스트용 — 예산 초과 테스트에 쓸 극소 예산 키 예산 (USD)
TEST_BUDGET_LIMIT=0.01
